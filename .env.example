# Optional overrides for docker-compose.yml. Copy to .env to use.
# GOOGLE_CLOUD_PROJECT=sew-swap-local
# MAIL_FROM=Sew Swap <no-reply@sewswap.local>
# API_PORT=8080
# WEB_PORT=5173

# --- Auth ---
# URL users open in their browser; used for email links and the Google redirect URI.
# APP_BASE_URL=http://localhost:5173
# HMAC key for sessions/login tokens. MUST be a long random value outside local dev
# (e.g. `openssl rand -base64 48`); in production store it in Secret Manager.
# AUTH_SECRET=dev-only-insecure-secret-change-me
# Google sign-in is hidden until both of these are set (see README).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Roles ---
# Comma-separated emails that are always admins (granted on sign-in). Admins grant every other role
# from the app. Local default: admin@example.test (used by the e2e tests).
# ADMIN_EMAILS=you@example.com
# Sign-in emails allowed per address per hour (production default 5; compose uses 50).
# LOGIN_REQUESTS_PER_HOUR=5

# --- Instagram check on swap sign-up ---
# Strategies tried in order (apps/api/src/instagram/strategies.ts). Production default:
# webProfileInfo,crawlerPage. Compose uses `fake` so local runs never call Instagram.
# INSTAGRAM_CHECK_STRATEGIES=webProfileInfo,crawlerPage
# Seconds a person must wait between checks (production default 10; compose uses 2).
# INSTAGRAM_CHECK_MIN_SECONDS=10
