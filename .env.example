# Optional overrides for docker-compose.yml. Copy to .env to use.
# GOOGLE_CLOUD_PROJECT=sew-swap-local
# SPANNER_INSTANCE=local-instance
# SPANNER_DATABASE=sew-swap
# MAIL_FROM=Sew Swap <no-reply@sewswap.local>
# API_PORT=8080
# WEB_PORT=5173

# --- Auth ---
# URL users open in their browser; used for email links and the Google redirect URI.
# APP_BASE_URL=http://localhost:5173
# HMAC key for sessions/login tokens. MUST be a long random value outside local dev
# (e.g. `openssl rand -base64 48`); in production store it in Secret Manager.
# AUTH_SECRET=dev-only-insecure-secret-change-me
# Google sign-in is hidden until both of these are set (see README).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
